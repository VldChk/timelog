@@ -297,6 +298,233 @@ static void pagespan_releasebuffer(PyObject* exporter, Py_buffer* view)
     TL_PY_OBJ_UNLOCK();
 }

+/*===========================================================================
+ * DLPack Export (__dlpack__ / __dlpack_device__)
+ *
+ * Exposes the page's ts[] int64 array as a zero-copy DLPack tensor using the
+ * versioned ABI (DLManagedTensorVersioned). The owner pin held in
+ * manager_ctx keeps the underlying snapshot pages alive; the deleter drops it.
+ *
+ * Capsule protocol (DLPack >= 1.0 versioned):
+ *   - Producer returns a PyCapsule named "dltensor_versioned".
+ *   - Consumer renames it to "used_dltensor_versioned" after taking ownership
+ *     and is then responsible for calling the deleter.
+ *   - If the consumer never takes it, the capsule destructor runs the deleter.
+ *===========================================================================*/
+
+/*
+ * manager_ctx layout: the DLManagedTensorVersioned and its single-element
+ * shape array are co-allocated with the struct so one free() releases all.
+ * The owner pin is held for the lifetime of the managed tensor.
+ */
+typedef struct {
+    DLManagedTensorVersioned mtv;
+    int64_t shape[1];
+    tl_pagespan_owner_t* owner;  /* pinned; dropped by deleter */
+} tl_pagespan_dlpack_ctx_t;
+
+/* DLPack deleter: drop the owner pin and free the co-allocated context.
+ * Runs OUTSIDE any internal lock (invoked by consumer or capsule destructor).
+ * owner_decref may run the release hook (pins_exit / drain), which is why this
+ * must never execute while a critical section is held. */
+static void tl_pagespan_dlpack_deleter(DLManagedTensorVersioned* self)
+{
+    if (self == NULL) {
+        return;
+    }
+    tl_pagespan_dlpack_ctx_t* ctx =
+        (tl_pagespan_dlpack_ctx_t*)self->manager_ctx;
+    if (ctx != NULL) {
+        if (ctx->owner != NULL) {
+            tl_pagespan_owner_decref(ctx->owner);
+            ctx->owner = NULL;
+        }
+        PyMem_Free(ctx);
+    }
+}
+
+/* Capsule destructor: only fires if the consumer never renamed the capsule
+ * (i.e. never took ownership). In that case we must run the deleter ourselves
+ * to drop the owner pin. Preserve exception state across the decref. */
+static void tl_pagespan_dlpack_capsule_destructor(PyObject* capsule)
+{
+    if (!PyCapsule_IsValid(capsule, "dltensor_versioned")) {
+        /* Consumer renamed to "used_dltensor_versioned" and owns it now. */
+        return;
+    }
+    DLManagedTensorVersioned* mtv =
+        (DLManagedTensorVersioned*)PyCapsule_GetPointer(
+            capsule, "dltensor_versioned");
+    if (mtv == NULL) {
+        PyErr_Clear();
+        return;
+    }
+    PyObject *exc_type, *exc_value, *exc_tb;
+    PyErr_Fetch(&exc_type, &exc_value, &exc_tb);
+    if (mtv->deleter != NULL) {
+        mtv->deleter(mtv);
+    }
+    PyErr_Restore(exc_type, exc_value, exc_tb);
+}
+
+static PyObject* PyPageSpan_dlpack(PyPageSpan* self, PyObject* args,
+                                   PyObject* kwds)
+{
+    /* Signature per Array API:
+     *   __dlpack__(self, *, stream=None, max_version=None, dl_device=None,
+     *              copy=None)
+     * We accept and validate but otherwise ignore stream/copy (CPU, zero-copy
+     * read-only export). dl_device must be CPU if specified. max_version, if
+     * given, must allow >= 1.0 (we only emit the versioned struct). */
+    static char* kwlist[] = {"stream", "max_version", "dl_device", "copy",
+                             NULL};
+    PyObject* stream = Py_None;
+    PyObject* max_version = Py_None;
+    PyObject* dl_device = Py_None;
+    PyObject* copy = Py_None;
+    if (!PyArg_ParseTupleAndKeywords(args, kwds, "|O$OOO:__dlpack__", kwlist,
+                                     &stream, &max_version, &dl_device,
+                                     &copy)) {
+        return NULL;
+    }
+
+    /* copy=True would require materializing a new buffer; we only do zero-copy
+     * (copy=False / None). A None/False request is honored. */
+    if (copy != Py_None) {
+        int truth = PyObject_IsTrue(copy);
+        if (truth < 0) {
+            return NULL;
+        }
+        if (truth) {
+            PyErr_SetString(PyExc_BufferError,
+                "PageSpan.__dlpack__ does not support copy=True "
+                "(zero-copy export only)");
+            return NULL;
+        }
+    }
+
+    /* dl_device, if specified, must be CPU (kDLCPU=1, id 0). */
+    if (dl_device != Py_None) {
+        long dev_type = -1, dev_id = -1;
+        if (!PyArg_ParseTuple(dl_device, "ll", &dev_type, &dev_id)) {
+            PyErr_SetString(PyExc_TypeError,
+                "dl_device must be a (device_type, device_id) tuple");
+            return NULL;
+        }
+        if (dev_type != (long)kDLCPU || dev_id != 0) {
+            PyErr_SetString(PyExc_BufferError,
+                "PageSpan can only be exported to the CPU device");
+            return NULL;
+        }
+    }
+
+    /* max_version, if specified, must permit DLPack >= 1.0 (we only emit the
+     * versioned managed tensor). max_version is a (major, minor) tuple. */
+    if (max_version != Py_None) {
+        long maj = -1, min = -1;
+        if (!PyArg_ParseTuple(max_version, "ll", &maj, &min)) {
+            PyErr_SetString(PyExc_TypeError,
+                "max_version must be a (major, minor) tuple");
+            return NULL;
+        }
+        if (maj < 1) {
+            PyErr_SetString(PyExc_BufferError,
+                "PageSpan requires DLPack version >= 1.0 (versioned ABI)");
+            return NULL;
+        }
+    }
+
+    (void)stream;  /* CPU: no stream synchronization required. */
+
+    /* Snapshot state under the critical section: validate open, capture
+     * ts/len, and pin the owner. The pin is dropped by the deleter (success)
+     * or below (any failure after pinning). self->len is uint32_t, so it
+     * always fits in int64 shape — no overflow check needed. */
+    int err = 0;  /* 0 ok, 1 closed, 2 no-buffer */
+    Py_ssize_t n = 0;
+    const tl_ts_t* ts_local = NULL;
+    tl_pagespan_owner_t* owner = NULL;
+
+    TL_PY_OBJ_LOCK(self);
+    if (self->closed) {
+        err = 1;
+    } else if (self->owner == NULL || self->ts == NULL) {
+        err = 2;
+    } else {
+        n = (Py_ssize_t)self->len;
+        ts_local = self->ts;
+        owner = self->owner;
+        tl_pagespan_owner_incref(owner);
+    }
+    TL_PY_OBJ_UNLOCK();
+
+    if (err == 1) {
+        PyErr_SetString(PyExc_ValueError, "PageSpan is closed");
+        return NULL;
+    }
+    if (err == 2) {
+        PyErr_SetString(PyExc_RuntimeError,
+            "PageSpan has no underlying buffer");
+        return NULL;
+    }
+
+    tl_pagespan_dlpack_ctx_t* ctx =
+        (tl_pagespan_dlpack_ctx_t*)PyMem_Malloc(sizeof(*ctx));
+    if (ctx == NULL) {
+        tl_pagespan_owner_decref(owner);
+        return PyErr_NoMemory();
+    }
+    memset(ctx, 0, sizeof(*ctx));
+    ctx->owner = owner;
+    ctx->shape[0] = (int64_t)n;
+
+    DLManagedTensorVersioned* mtv = &ctx->mtv;
+    mtv->version.major = DLPACK_MAJOR_VERSION;
+    mtv->version.minor = DLPACK_MINOR_VERSION;
+    mtv->manager_ctx = ctx;
+    mtv->deleter = tl_pagespan_dlpack_deleter;
+    /* ts is immutable after publication: advertise read-only. */
+    mtv->flags = DLPACK_FLAG_BITMASK_READ_ONLY;
+
+    DLTensor* t = &mtv->dl_tensor;
+    t->data = (void*)ts_local;
+    t->device.device_type = kDLCPU;
+    t->device.device_id = 0;
+    t->ndim = 1;
+    t->dtype.code = (uint8_t)kDLInt;
+    t->dtype.bits = (uint8_t)(sizeof(tl_ts_t) * 8);  /* int64 -> 64 */
+    t->dtype.lanes = 1;
+    t->shape = ctx->shape;
+    t->strides = NULL;  /* contiguous, row-major */
+    t->byte_offset = 0;
+
+    PyObject* capsule = PyCapsule_New(mtv, "dltensor_versioned",
+                                      tl_pagespan_dlpack_capsule_destructor);
+    if (capsule == NULL) {
+        /* Drops the owner pin and frees ctx. */
+        tl_pagespan_dlpack_deleter(mtv);
+        return NULL;
+    }
+    return capsule;
+}
+
+static PyObject* PyPageSpan_dlpack_device(PyPageSpan* self, PyObject* noargs)
+{
+    (void)noargs;
+
+    int closed;
+    TL_PY_OBJ_LOCK(self);
+    closed = self->closed;
+    TL_PY_OBJ_UNLOCK();
+
+    if (closed) {
+        PyErr_SetString(PyExc_ValueError, "PageSpan is closed");
+        return NULL;
+    }
+    /* (device_type, device_id) = (kDLCPU=1, 0). */
+    return Py_BuildValue("(ii)", (int)kDLCPU, 0);
+}
+
