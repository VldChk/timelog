      "copy_timestamps() -> list[int]\n\n"
      "Return a copy of timestamps as a Python list."},
+    {"__dlpack__", (PyCFunction)(void(*)(void))PyPageSpan_dlpack,
+     METH_VARARGS | METH_KEYWORDS,
+     "__dlpack__(stream=None, *, max_version=None, dl_device=None, "
+     "copy=None) -> PyCapsule\n\n"
+     "Export the timestamps (int64) as a read-only, zero-copy DLPack tensor.\n"
+     "Consumable by np.from_dlpack() and other DLPack-aware libraries."},
+    {"__dlpack_device__", (PyCFunction)PyPageSpan_dlpack_device, METH_NOARGS,
+     "__dlpack_device__() -> tuple[int, int]\n\n"
+     "Return the DLPack (device_type, device_id) pair: (kDLCPU=1, 0)."},
     {"__enter__", (PyCFunction)PyPageSpan_enter, METH_NOARGS,
      "Context manager entry."},
     {"__exit__", (PyCFunction)PyPageSpan_exit, METH_VARARGS,
diff --git a/python/tests/test_facade.py b/python/tests/test_facade.py
index 4cefec0..b80aa2d 100644
--- a/python/tests/test_facade.py
+++ b/python/tests/test_facade.py
@@ -560,6 +560,126 @@ class TestPageSpanBuffers:
                     pass


+# =============================================================================
+# Category 8b: PageSpan DLPack export
+# =============================================================================
+
+
+class TestPageSpanDLPack:
+    """DLPack (__dlpack__ / __dlpack_device__) export for PageSpan."""
+
+    def test_dlpack_device_is_cpu(self):
+        """__dlpack_device__() returns (kDLCPU=1, 0)."""
+        from timelog import Timelog
+
+        with Timelog(maintenance="disabled") as log:
+            log.extend([(i, i) for i in range(8)])
+            log.flush()
+            span = next(log.views(0, 8))
+            try:
+                assert span.__dlpack_device__() == (1, 0)
+            finally:
+                span.close()
+
+    def test_dlpack_capsule_is_versioned(self):
+        """__dlpack__() returns a versioned DLPack capsule."""
+        from timelog import Timelog
+
+        with Timelog(maintenance="disabled") as log:
+            log.extend([(i, i) for i in range(4)])
+            log.flush()
+            span = next(log.views(0, 4))
+            try:
+                cap = span.__dlpack__()
+                assert "dltensor_versioned" in repr(cap)
+                del cap  # unconsumed-capsule destructor drops the owner pin
+            finally:
+                span.close()
+
+    def test_dlpack_closed_raises(self):
+        """DLPack methods raise on a closed span."""
+        from timelog import Timelog
+
+        with Timelog(maintenance="disabled") as log:
+            log.extend([(i, i) for i in range(4)])
+            log.flush()
+            span = next(log.views(0, 4))
+            span.close()
+            with pytest.raises(ValueError, match="closed"):
+                span.__dlpack__()
+            with pytest.raises(ValueError, match="closed"):
+                span.__dlpack_device__()
+
+    def test_dlpack_rejects_copy_and_non_cpu(self):
+        """copy=True, non-CPU device, and pre-1.0 max_version are rejected."""
+        from timelog import Timelog
+
+        with Timelog(maintenance="disabled") as log:
+            log.extend([(i, i) for i in range(4)])
+            log.flush()
+            span = next(log.views(0, 4))
+            try:
+                with pytest.raises(BufferError):
+                    span.__dlpack__(copy=True)
+                with pytest.raises(BufferError):
+                    span.__dlpack__(dl_device=(2, 0))
+                with pytest.raises(BufferError):
+                    span.__dlpack__(max_version=(0, 8))
+            finally:
+                span.close()
+
+    def test_dlpack_numpy_zero_copy_readonly(self):
+        """np.from_dlpack aliases the page buffer read-only (zero-copy)."""
+        np = pytest.importorskip("numpy")
+        if tuple(int(p) for p in np.__version__.split(".")[:1]) < (2,):
+            pytest.skip("numpy>=2 required for from_dlpack")
+        from timelog import Timelog
+
+        with Timelog(maintenance="disabled") as log:
+            log.extend([(i, i) for i in range(8)])
+            log.flush()
+            span = next(log.views(0, 8))
+            mv = None
+            try:
+                arr = np.from_dlpack(span)
+                assert arr.dtype == np.int64
+                assert arr.shape == (8,)
+                assert arr.tolist() == list(range(8))
+                # READ_ONLY flag: numpy array must be non-writable.
+                assert arr.flags.writeable is False
+                with pytest.raises(ValueError):
+                    arr[0] = 999
+                # Zero-copy: DLPack data pointer == buffer-protocol pointer.
+                mv = memoryview(span)
+                bp = np.frombuffer(mv, dtype=np.int64)
+                assert (arr.__array_interface__["data"][0]
+                        == bp.__array_interface__["data"][0])
+                del arr, bp
+            finally:
+                if mv is not None:
+                    mv.release()
+                span.close()
+
+    def test_dlpack_array_outlives_span_close(self):
+        """The owner pin keeps page memory alive after span.close()."""
+        np = pytest.importorskip("numpy")
+        if tuple(int(p) for p in np.__version__.split(".")[:1]) < (2,):
+            pytest.skip("numpy>=2 required for from_dlpack")
+        from timelog import Timelog
+
+        with Timelog(maintenance="disabled") as log:
+            log.extend([(i, i) for i in range(8)])
+            log.flush()
+            span = next(log.views(0, 8))
+            arr = np.from_dlpack(span)
+            span.close()  # consumer owns the managed tensor; pages stay alive
+            del span
+            gc.collect()
+            assert arr.tolist() == list(range(8))
+            del arr
+            gc.collect()
+
+
 # =============================================================================
 # Category 9: Weakrefs
 # =============================================================================
