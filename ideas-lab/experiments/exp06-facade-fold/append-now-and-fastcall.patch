+/*===========================================================================
+ * PyTimelog_append_now  (ideas-lab exp06 / N28 verification)
+ *
+ * Auto-timestamp + append in ONE C call (METH_O, no args tuple). Eliminates the
+ * Python facade wrapper AND its second Python->C transition (time.time_ns()).
+ * MVP: assumes 'ms' time_unit; a production version reads self's configured unit.
+ *===========================================================================*/
+static PyObject*
+PyTimelog_append_now(PyTimelog* self, PyObject* obj)
+{
+    CHECK_CLOSED(self);
+
+    struct timespec tnow;
+    clock_gettime(CLOCK_REALTIME, &tnow);
+    long long ts_ll = (long long)tnow.tv_sec * 1000LL + tnow.tv_nsec / 1000000LL; /* ms */
+
+    if (tl_py_validate_ts(ts_ll, "timestamp") < 0) {
+        return NULL;
+    }
+    Py_INCREF(obj);
+    tl_handle_t h = tl_py_handle_encode(obj);
+    tl_ts_t ts = (tl_ts_t)ts_ll;
+    tl_status_t st;
+    if (tl_py_lock_checked(self) < 0) {
+        Py_DECREF(obj);
+        return NULL;
+    }
+    tl_py_handle_ctx_t* hctx = tl_py_own_handle_ctx_locked(self);
+    st = tl_append(self->tl, ts, h);
+    TL_PY_UNLOCK(self);
+
+    if (st == TL_OK) {
+        (void)tl_py_live_note_insert(hctx, obj);
+        goto an_success;
+    }
+    if (st == TL_EBUSY) {
+        (void)tl_py_live_note_insert(hctx, obj);
+        if (tl_py_handle_write_ebusy(self,
+                "Record inserted but backpressure occurred.") < 0) {
+            tl_py_handle_ctx_decref(hctx);
+            return NULL;
+        }
+        goto an_success;
+    }
+    Py_DECREF(obj);
+    tl_py_handle_ctx_decref(hctx);
+    return TL_PY_RAISE_STATUS(self, st);
+
+an_success:
+    tl_py_drain_retired(hctx, 0);
+    tl_py_handle_ctx_decref(hctx);
+    Py_RETURN_NONE;
+}
