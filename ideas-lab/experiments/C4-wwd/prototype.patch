index 6ade422..ed01b50 100644
--- a/core/src/maint/tl_compaction.c
+++ b/core/src/maint/tl_compaction.c
@@ -79,6 +79,10 @@ void tl_compact_ctx_destroy(tl_compact_ctx_t* ctx) {
     ctx->input_l1 = NULL;
     ctx->input_l1_len = 0;
 
+    tl__free(ctx->alloc, ctx->dropped_l1);
+    ctx->dropped_l1 = NULL;
