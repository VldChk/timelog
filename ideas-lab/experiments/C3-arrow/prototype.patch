+/**
+ * @file arrow_c_data.h
+ * @brief Apache Arrow C Data Interface struct definitions (ABI-stable).
+ *
+ * These two structs (ArrowSchema, ArrowArray) plus their release callbacks
+ * are the Arrow C Data Interface — a stable, dependency-free ABI for sharing
+ * columnar data across language/library boundaries with zero copy.
+ *
+ * Spec: https://arrow.apache.org/docs/format/CDataInterface.html
+ *
+ * We hand-roll these here (rather than vendoring nanoarrow) because the
+ * export path is a single non-nullable int64 column: the full ABI fits in a
+ * few dozen lines and adds no build dependency.
+ *
+ * IMPORTANT: This header MUST match the canonical Arrow definitions byte-for-
+ * byte (field order, types). The struct layout is part of the ABI contract.
+ */
+
+#ifndef TL_PY_ARROW_C_DATA_H
+#define TL_PY_ARROW_C_DATA_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#ifndef ARROW_C_DATA_INTERFACE
+#define ARROW_C_DATA_INTERFACE
+
+#define ARROW_FLAG_DICTIONARY_ORDERED 1
+#define ARROW_FLAG_NULLABLE 2
+#define ARROW_FLAG_MAP_KEYS_SORTED 4
+
+struct ArrowSchema {
+    /* Array type description */
+    const char* format;
+    const char* name;
+    const char* metadata;
+    int64_t flags;
+    int64_t n_children;
+    struct ArrowSchema** children;
+    struct ArrowSchema* dictionary;
+
+    /* Release callback */
+    void (*release)(struct ArrowSchema*);
+    /* Opaque producer-specific data */
+    void* private_data;
+};
+
+struct ArrowArray {
+    /* Array data description */
+    int64_t length;
+    int64_t null_count;
+    int64_t offset;
+    int64_t n_buffers;
+    int64_t n_children;
+    const void** buffers;
+    struct ArrowArray** children;
+    struct ArrowArray* dictionary;
+
+    /* Release callback */
+    void (*release)(struct ArrowArray*);
+    /* Opaque producer-specific data */
+    void* private_data;
+};
+
+#endif /* ARROW_C_DATA_INTERFACE */
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* TL_PY_ARROW_C_DATA_H */
